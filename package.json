{
  "name": "ac-ebay-readonly",
  "version": "0.2.0",
  "private": true,
  "description": "A locally enforced, read-only eBay MCP for Al and Amazing Claude.",
  "type": "module",
  "bin": {
    "ac-ebay-readonly": "readonly/index.mjs"
  },
  "main": "readonly/index.mjs",
  "scripts": {
    "start": "node readonly/index.mjs",
    "setup": "node readonly/setup.mjs",
    "test": "node --test readonly/*.test.mjs",
    "check": "node --check readonly/core.mjs && node --check readonly/index.mjs && node --check readonly/setup.mjs && node --check readonly/connect.mjs && node --check readonly/oauth-connect.mjs && npm test",
    "build": "npm run check",
    "verify": "npm run check",
    "pack:desktop": "node readonly/build-mcpb.mjs",
    "connect": "node readonly/connect.mjs"
  },
  "files": [
    "readonly/core.mjs",
    "readonly/catalog.json",
    "readonly/index.mjs",
    "readonly/setup.mjs",
    "readonly/connect.mjs",
    "readonly/oauth-connect.mjs",
    "readonly/OAUTH_SETUP.md",
    "readonly/DESKTOP_EXTENSION.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vrennat/ebay-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7",
    "fast-xml-parser": "5.9.0"
  },
  "overrides": {
    "hono": ">=4.13.7",
    "@hono/node-server": ">=1.19.15",
    "qs": ">=6.16.0"
  }
}
